# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.mypy_cache/
.hypothesis/

# Virtual environments (should be rebuilt inside the container)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
pythonenv*

# Version Control
.git/
.gitignore
.gitattributes
.svn/
.hg/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.iml

# Docker-related (prevents infinite loops and invalidates cache)
Dockerfile
docker-compose*.yml
.dockerignore

# Environment variables and Secrets (CRITICAL for security)
.env
.env.*
*.key
*.pem
*.crt
*.p12
secrets/
.terraform/

# Project-specific source code (We will copy specific folders via Dockerfile)
# Note: We ignore tests, but keep the actual app source.
tests/
docs/
examples/
notebooks/
*.rst

# Logs and databases
logs/
*.log
*.sqlite
*.sqlite3
*.db
data/

# OS & Temporary files
*.tmp
*.temp
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Deployment & CI/CD
.github/
.gitlab/
.azure/
.vscode/
.terraform/
*.tfstate
*.tfvars
